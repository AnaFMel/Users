@Kong_HostAddress = http://localhost:8000

### 1. Autenticar e obter token
# @name login
POST {{Kong_HostAddress}}/user/auth
Content-Type: application/json

{
  "email": "admin@fiapcloud.com.br",
  "password": "admin"
}

###

### 2. Criar usuário
POST {{Kong_HostAddress}}/user/create
Authorization: Bearer {{login.response.body.$.token}}
Content-Type: application/json

{
  "name": "Usuário Teste",
  "email": "usuario.teste@fiap.com",
  "password": "Teste@1234!",
  "roleId": 2
}

###

### 3. Obter todos os usuários 
GET {{Kong_HostAddress}}/user/
Authorization: Bearer {{login.response.body.$.token}}

###

### 4. Obter usuário pelo ID
GET {{Kong_HostAddress}}/user/2
Authorization: Bearer {{login.response.body.$.token}}

###

### 5. Obter usuário pelo e-mail
GET {{Kong_HostAddress}}/user/usuario.teste@fiap.com
Authorization: Bearer {{login.response.body.$.token}}

###
